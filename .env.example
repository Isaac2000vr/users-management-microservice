# Copiar este archivo a .env y completar con las credenciales reales.
# .env esta ignorado por git y no se sube al repositorio.

PORT=8080

# Base de datos en TiDB Cloud Serverless
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=cambiar-por-la-contrasena-real
DB_SSL_MODE=REQUIRED

# Correo (opcional en local; las notificaciones son asincronas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Usuarios

# JWT (en produccion usar un secreto propio de al menos 32 bytes en Base64)
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=900
