                  "  pm.expect(pm.response.json().status).to.eql(\"CONFIRMED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-11-11\",\n  \"hotel\": \"Hotel Cartagena\",\n  \"huesped\": \"Juan Perez\",\n  \"fechaInicio\": \"2026-12-01\",\n  \"fechaFin\": \"2026-12-05\",\n  \"valor\": 500000.0,\n  \"habitacion\": \"302\",\n  \"numAcompanantes\": 3,\n  \"pais\": \"Colombia\",\n  \"departamento\": \"Bolivar\",\n  \"ciudad\": \"Cartagena\",\n  \"horaCheckin\": \"15:00\",\n  \"horaCheckout\": \"12:00\",\n  \"empleadoAtiende\": \"Maria Lopez\",\n  \"empleadoDespide\": \"Carlos Ruiz\",\n  \"descripcion\": \"Cambio de habitacion\",\n  \"status\": \"CONFIRMED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/reservas-hotel/{{reservaId}}"
          }
        },
        {
          "name": "Eliminar reserva",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"eliminada\", function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/reservas-hotel/{{reservaId}}"
          }
        },
        {
          "name": "Listar reservas sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"no autorizado\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reservas-hotel"
          }
        }
      ]
    }
  ]
}
